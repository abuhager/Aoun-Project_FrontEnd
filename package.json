{
  "name": "aoun-frontend",
  "version": "0.1.0",
  "description": "Next.js frontend for the Aoun donation platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.mjs",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --grep @ci",
    "verify": "npm run lint && npm run typecheck && npm test",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['.next','node_modules/.cache']) fs.rmSync(path,{recursive:true,force:true})\""
  },
  "dependencies": {
    "axios": "^1.20.0",
    "firebase": "^12.19.0",
    "material-symbols": "0.47.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.3",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
