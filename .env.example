# Public/backend API origins (origin only; no path, query, or trailing slash)
NEXT_PUBLIC_API_URL=https://api.example.com
BACKEND_URL=https://api.example.com

# Client request/session timing
NEXT_PUBLIC_API_TIMEOUT=15000
NEXT_PUBLIC_AUTH_INIT_TIMEOUT=5000
NEXT_PUBLIC_AUTH_SAFETY_TIMEOUT=10000
NEXT_PUBLIC_SESSION_EXPIRE_DAYS=7

# Optional product features
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false
NEXT_PUBLIC_PHONE_VERIFICATION_ENABLED=false

# Required only when phone verification is enabled
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
